# env file for dev (kbackend running on the host via Gradle, not Docker)
# secretlint-disable
FLEX_DATABASE_URL=jdbc:postgresql://localhost:5432/flex
FLEX_DATABASE_USERNAME=flex_authenticator
FLEX_DATABASE_PASSWORD=authenticator_password
FLEX_JWT_SECRET=rqQHuW5MppUkriINN1gr1JWjftoJYWhn1234567890ohausd987ahf8a7hsf0a7shf0ash7f
ACCOUNTING_POINT_ADAPTER_BASE_URL=http://localhost:5001
ACCOUNTING_POINT_ADAPTER_API_KEY=key
S3_BUCKET=flex-attachments
# both endpoints use localhost (S3Mock is in Docker but its port is exposed)
# no nginx in dev, so no CSP restrictions: the browser can fetch localhost:9090 directly
S3_INTERNAL_ENDPOINT=http://localhost:9090
S3_PUBLIC_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_ACCESS_KEY=dummy
S3_SECRET_KEY=dummy
FLEX_POSTGREST_URL=http://localhost:3000
FLEX_BASE_URL=https://dev.flex.internal:5443/
FLEX_OIDC_CLIENT_ID=flex_oidc_client_id_value
FLEX_OIDC_CLIENT_SECRET=flex_oidc_client_secret_value
FLEX_OIDC_ISSUER=https://idp.flex.internal:9091/
FLEX_OIDC_POST_LOGOUT_REDIRECT_URL=https://dev.flex.internal:5443/#/login
FLEX_OIDC_REDIRECT_URL=https://dev.flex.internal:5443/auth/v1/callback
